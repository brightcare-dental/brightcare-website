{
  "functions": {
    "public_html/*.php": { "runtime": "vercel-php@0.9.0" },
    "public_html/admin/*.php": { "runtime": "vercel-php@0.9.0" },
    "public_html/api/*.php": { "runtime": "vercel-php@0.9.0" }
  },
  "routes": [
    { "src": "/includes/(.*)", "status": 404 },
    { "src": "/public_html/includes/(.*)", "status": 404 },
    { "src": "/admin/_install\\.php", "status": 404 },
    { "src": "/admin/_cases\\.php", "status": 404 },

    { "src": "/assets/(.*)", "dest": "/public_html/assets/$1" },
    { "src": "/admin/assets/(.*)", "dest": "/public_html/admin/assets/$1" },

    { "handle": "filesystem" },

    { "src": "/sitemap\\.xml", "dest": "/public_html/sitemap.php" },
    { "src": "/robots\\.txt", "dest": "/public_html/robots.php" },

    { "src": "/services/([a-z0-9-]+)/?$", "dest": "/public_html/service.php?s=$1" },
    { "src": "/blog/([a-z0-9-]+)/?$", "dest": "/public_html/post.php?s=$1" },
    { "src": "/case/([a-z0-9-]+)/?$", "dest": "/public_html/case.php?s=$1" },

    { "src": "/admin/?$", "dest": "/public_html/admin/index.php" },
    { "src": "/$", "dest": "/public_html/index.php" },
    { "src": "/([a-z0-9-]+)/?$", "dest": "/public_html/$1.php" }
  ]
}
