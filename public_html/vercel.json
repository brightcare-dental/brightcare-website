{
  "functions": {
    "*.php": { "runtime": "vercel-php@0.9.0" },
    "admin/*.php": { "runtime": "vercel-php@0.9.0" },
    "api/*.php": { "runtime": "vercel-php@0.9.0" }
  },
  "routes": [
    { "src": "/includes/(.*)", "status": 404 },
    { "src": "/admin/_install\\.php", "status": 404 },
    { "src": "/admin/_cases\\.php", "status": 404 },

    { "handle": "filesystem" },

    { "src": "/sitemap\\.xml", "dest": "/sitemap.php" },
    { "src": "/robots\\.txt", "dest": "/robots.php" },

    { "src": "/services/([a-z0-9-]+)/?$", "dest": "/service.php?s=$1" },
    { "src": "/blog/([a-z0-9-]+)/?$", "dest": "/post.php?s=$1" },
    { "src": "/case/([a-z0-9-]+)/?$", "dest": "/case.php?s=$1" },

    { "src": "/admin/?$", "dest": "/admin/index.php" },
    { "src": "/$", "dest": "/index.php" },
    { "src": "/([a-z0-9-]+)/?$", "dest": "/$1.php" }
  ]
}
